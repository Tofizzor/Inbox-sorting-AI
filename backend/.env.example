# LLM provider: ollama | openai | anthropic | mock
# mock — deterministic offline responses; no API key or network required
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Ollama (local dev — no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# OpenAI (LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# Cloud providers (openai / anthropic only; not used for ollama or mock)
LLM_API_KEY=

# SQLite database (path relative to backend/)
DATABASE_URL=sqlite:///./data/inbox.db

# Max attempts when LLM returns invalid JSON (user preference: start with 2)
MAX_LLM_RETRIES=2

DATA_DIR=data
